<div class="container">
  <h1 class="mb-4">OPA Ship Registry</h1>
  <p class="text-muted">Maintain an up-to-date list of vessels under Tycho Station supervision.</p>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card bg-card shadow h-100 hover-raise">
        <div class="card-body">
          <span class="badge opa-badge">OPS</span>
          <h5 class="card-title d-inline ms-2">Add New Ship</h5>
          <form method="post" action="/sql/insecure-insert" class="vstack gap-2 mt-2">
            <input class="form-control" name="name" placeholder="Rocinante" required>
            <input class="form-control" name="registry" placeholder="XN-121" required>
            <input class="form-control" name="faction" placeholder="OPA" required>
            <input class="form-control" name="tonnage" type="number" placeholder="12000" min="0">
            <button class="btn btn-primary" type="submit">Submit</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card bg-card shadow h-100 hover-raise">
        <div class="card-body">
          <span class="badge opa-badge">DATA</span>
          <h5 class="card-title d-inline ms-2">Search Ships</h5>
          <form method="get" action="/sql/insecure-search" class="d-flex gap-2 mt-2">
            <input class="form-control" name="q" placeholder="Search...">
            <button class="btn btn-primary" type="submit">Search</button>
          </form>
          <small class="text-muted d-block mt-2">Results return as JSON for integration testing.</small>
        </div>
      </div>
    </div>
  </div>

  <hr class="my-4" />
  <h3>Current Ships</h3>
  <div class="table-responsive">
    <table class="table table-striped table-dark align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Registry</th>
          <th>Faction</th>
          <th>Tonnage</th>
        </tr>
      </thead>
      <tbody>
        <% if (!ships || ships.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted">No ships in registry yet.</td></tr>
        <% } else { ships.forEach(s => { %>
          <tr>
            <td><%= s.id %></td>
            <td><%= s.name %></td>
            <td><%= s.registry %></td>
            <td><%= s.faction %></td>
            <td><%= s.tonnage %></td>
          </tr>
        <% }) } %>
      </tbody>
    </table>
  </div>
</div>