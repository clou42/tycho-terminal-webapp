<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Station Services — Tycho</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      --bg:#0b1220; --panel:#0f1b2d; --panel2:#142641; --fg:#e6f1ff; --muted:#E4E7ED;
      --accent:#0ea5e9; --accent2:#ff6a00; --bad:#ef4444; --ok:#22c55e;
    }
    html,body{background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Arial,sans-serif}
    a{color:var(--accent)}
    .wrap{max-width:980px;margin:32px auto;padding:0 16px}
    .card{background:var(--panel);border:1px solid #1c2c4a;border-radius:12px;padding:16px;margin-bottom:16px}
    .card h2{margin:0 0 8px;font-size:1.1rem}
    .note{color:var(--muted)}
    .bad{color:var(--bad)} .ok{color:var(--ok)}
    pre,code{color:#d1ffe0;background:#0f1f33;border:1px solid #23406a;border-radius:10px;padding:10px;overflow:auto}
    table{width:100%;border-collapse:collapse;color:var(--fg);font-size:.95rem}
    th,td{border-bottom:1px solid #1c2c4a;padding:6px 8px;text-align:left;vertical-align:top}
    .pill{display:inline-block;width:10px;height:10px;border-radius:50%}
    .pill-red{background:#ef4444}.pill-amber{background:#f59e0b}.pill-green{background:#22c55e}
    .dim{opacity:.9}
    .hdr{display:flex;align-items:center;gap:10px;margin-bottom:12px}
    .btn{display:inline-block;padding:8px 12px;border-radius:10px;border:1px solid #27456f;color:var(--fg);text-decoration:none}
    .btn:hover{background:#132238}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="hdr">
      <span class="pill pill-red"></span><span class="pill pill-amber"></span><span class="pill pill-green"></span>
      <h1 style="margin:0">Station Services</h1>
      <span class="dim">opa://tycho/services</span>
      <a class="btn" href="/">← Back to Terminal</a>
    </div>

    <!-- Under construction banner -->
    <div class="card">
      <h2 style="color: white";>Under Construction</h2>
      <p class="note">
        This console is still being wired into Tycho’s service grid. Some panels may show diagnostics or placeholder feeds.
        Please ignore any transient anomalies below.
      </p>
      <pre>
████ Tycho Station Ops ── Subsystem: Station Services
Status: DEGRADED · Ring Bus: PARTIAL · ProtoMux: WARNING
      </pre>
    </div>


    <div class="card">
      <h2 style="color: white";>Service Console Logs</h2>
      <ul style="margin:0;padding-left:18px">
        <% errors.forEach(function(line){ %>
          <li><code><%= line %></code></li>
        <% }) %>
      </ul>
      <p class="note" style="margin-top:10px">If you can read this, logging may be set to <strong>verbose</strong> on a public channel.</p>
    </div>

    <div class="card">
      <h2 style="color: white";>Diagnostics</h2>
      <p class="note">
        ⚠️ Internal payload attached by watchdog. This section is for maintainers only and will be removed. Do not distribute.
      </p>

      <details open>
        <summary><strong style="color: white";>Environment Variables</strong> </summary>
        <div style="margin-top:10px;max-height:420px;overflow:auto;border:1px solid #1c2c4a;border-radius:10px">
          <table>
            <thead>
              <tr><th style="width:38%">Key</th><th>Value</th></tr>
            </thead>
            <tbody>
              <% env.forEach(function(kv){ %>
                <tr>
                  <td><code><%= kv.key %></code></td>
                  <td><code><%= kv.value %></code></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </details>

    </div>
  </div>
</body>
</html>
